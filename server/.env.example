# Copy to server/.env and adjust. All values are optional.

# ORBIT_PORT=8443
# ORBIT_OLLAMA_URL=http://localhost:11434
# ORBIT_LLM_MODEL=qwen3:8b
# ORBIT_STT_MODEL=base.en

# Kokoro files. Empty = Pipecat's cache (~/.cache/pipecat/kokoro-onnx).
# ORBIT_KOKORO_MODEL=C:\path\to\kokoro-v1.0.onnx
# ORBIT_KOKORO_VOICES=C:\path\to\voices-v1.0.bin

# Seconds of silence before the assistant replies.
# ORBIT_SILENCE_SECONDS=1.0

# Set to 1 once, with internet, to download missing models; leave unset for offline use.
# ORBIT_ALLOW_DOWNLOADS=1
