{
  "name": "orbit2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build",
    "dev": "node scripts/serve-ui.mjs",
    "dev:live": "npm run dev",
    "dev:voice": "vite --mode live",
    "server": "python server/run.py",
    "build": "node node_modules/typescript/bin/tsc -b && node scripts/build-ui.mjs",
    "preview": "node scripts/serve-ui.mjs --built",
    "typecheck": "node node_modules/typescript/bin/tsc -b --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "npm run test:crew && node --experimental-vm-modules --test tests/*.test.mjs",
    "test:evidence": "node --experimental-vm-modules --test tests/evidence.test.mjs",
    "test:crew": "vitest run src/modules/crew",
    "dev:crew": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@pipecat-ai/client-js": "1.16.0",
    "@pipecat-ai/client-react": "1.11.0",
    "@pipecat-ai/small-webrtc-transport": "1.11.2",
    "lucide-react": "1.73.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "3.10.1",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "three": "0.181.2",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@types/three": "0.181.0",
    "@types/qrcode": "1.5.6",
    "prettier": "3.10.1",
    "vite-plugin-pwa": "2.0.0"
  }
}
